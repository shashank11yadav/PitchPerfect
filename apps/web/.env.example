# apps/web environment. Copy to apps/web/.env.local for local development.

# Where Next.js proxies /api/* (server-side only, never exposed to the browser)
API_ORIGIN=http://localhost:4000

# Canonical public URL used for metadata, canonical links, sitemap, and Open Graph
SITE_URL=http://localhost:3000

# Optional: must match PROXY_SHARED_SECRET in apps/api/.env when set
PROXY_SHARED_SECRET=
