# apps/api environment. Copy to apps/api/.env for local development.
# Values below work for local development only. In production every secret must be
# replaced; config.ts refuses to start in production if any value starts with "dev-only-".

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# a hop count or proxy addresses; true and * are refused
TRUST_PROXY=0

# Public URL of the web app. Used for email links, the CSRF Origin check, and cookies.
APP_URL=http://localhost:3000

# MongoDB connection string (docker compose exposes mongo on 27017)
MONGODB_URI=mongodb://localhost:27017/pitchperfect

# Session cookie signing secret and CSRF secret (generate: openssl rand -base64 64)
SESSION_SECRET=dev-only-session-secret-replace-me-in-production-0000000000000000
CSRF_SECRET=dev-only-csrf-secret-replace-me-in-production-00000000000000000000

# Practice partner service and the shared HMAC secret (must match apps/coach/.env)
COACH_URL=http://localhost:4100
COACH_SHARED_SECRET=dev-only-coach-shared-secret-replace-me-000000000000

# Optional: shared secret web sends as x-pp-proxy; when set, api rejects requests without it
PROXY_SHARED_SECRET=

# Email (docker compose runs Mailpit: SMTP on 1025, inbox UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PitchPerfect <no-reply@pitchperfect.local>"

# Practice limits
PRACTICE_DAILY_LIMIT=5
PRACTICE_MONTHLY_LIMIT=30
PRACTICE_DAILY_TOKEN_BUDGET=2000000
PRACTICE_RETENTION_DAYS=180
PRACTICE_STUDENT_DAILY_TOKEN_LIMIT=250000

# Breached-password check (k-anonymity range API). Set false to use only the offline list.
HIBP_ENABLED=true


# Password for the two demo accounts created by `npm run seed -- --demo` (local/demo only).
# Required when seeding demo accounts; choose any 12+ character passphrase.
SEED_DEMO_PASSWORD=
