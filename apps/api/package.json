{
  "name": "@pitchperfect/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/services/data', 'dist/services/data', { recursive: true })\"",
    "start": "node dist/server.js",
    "seed": "NODE_ENV=development tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "admin": "NODE_ENV=development tsx --env-file-if-exists=.env src/scripts/admin.ts",
    "purge": "NODE_ENV=development tsx --env-file-if-exists=.env src/scripts/purge-expired.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "admin:prod": "node dist/scripts/admin.js",
    "purge:prod": "node dist/scripts/purge-expired.js"
  },
  "dependencies": {
    "@pitchperfect/shared": "0.0.0",
    "argon2": "0.45.1",
    "connect-mongo": "6.0.0",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "disposable-email-domains-js": "1.26.0",
    "email-providers": "2.27.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "mongoose": "9.11.2",
    "multer": "2.5.0",
    "nodemailer": "10.1.7",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sanitize-html": "2.18.1",
    "tldts": "7.4.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pitchperfect/coach": "0.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
