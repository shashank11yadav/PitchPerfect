{
  "name": "@pitchperfect/coach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@pitchperfect/shared": "0.0.0",
    "fastify": "5.12.7",
    "openai": "7.39.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
