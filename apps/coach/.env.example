# apps/coach environment. Copy to apps/coach/.env for local development.
# The coach must never be reachable from the public internet.

NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info

# Must match COACH_SHARED_SECRET in apps/api/.env (generate: openssl rand -base64 48)
COACH_SHARED_SECRET=dev-only-coach-shared-secret-replace-me-000000000000

# Which LLM provider powers the practice partner: fake | openai | anthropic
# "fake" is deterministic and offline; it needs no key and is used by tests and e2e.
COACH_PROVIDER=fake

# Provider keys (only the selected provider's key is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model IDs for the selected provider (required unless COACH_PROVIDER=fake).
# Use current model IDs from your provider's documentation.
# COACH_MODEL handles persona planning, replies, and the guard check;
# COACH_SCORING_MODEL handles scorecards (can be the same model).
COACH_MODEL=
COACH_SCORING_MODEL=

# Per-call timeout in milliseconds
COACH_TIMEOUT_MS=30000
