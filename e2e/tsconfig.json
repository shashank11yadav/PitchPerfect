{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../node_modules/.cache/tsc-e2e",
    "emitDeclarationOnly": true,
    // Playwright loads these files itself and resolves extensionless imports.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2023"],
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
